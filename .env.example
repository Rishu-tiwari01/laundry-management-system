# Required in production
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Comma-separated list. On Render, RENDER_EXTERNAL_HOSTNAME is auto-appended.
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (must include scheme).
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Postgres connection string. If unset, falls back to local sqlite db.sqlite3.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional log level override
# DJANGO_LOG_LEVEL=INFO
